# Hugging Face Inference Providers token. Keep the real value only in .env or Railway variables.
HF_TOKEN=hf_your_token_here

# All three can initially use the same Qwen vision-language model.
# Set separate values later only after testing each model in the Hugging Face Playground.
HF_GENERAL_MODEL_ID=Qwen/Qwen3-32B
HF_MULTIMODAL_MODEL_ID=Qwen/Qwen2-VL-72B-Instruct
HF_MULTIMODAL_FALLBACK_MODEL_ID=Qwen/Qwen2-VL-72B-Instruct
HF_QUIZ_MODEL_ID=Qwen/Qwen2.5-72B-Instruct
